# syntax=docker/dockerfile:1.7
# GPU runtime base (host must have nvidia-driver + nvidia-container-toolkit)
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# --- OS deps (build tools, MPI, NCCL headers), curl for uv installer ---
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential git curl ca-certificates pkg-config \
    openmpi-bin libopenmpi-dev \
    libnccl2 libnccl-dev \
    && rm -rf /var/lib/apt/lists/*

# (Optional) UCX if you want advanced transport for multi-node jobs
# RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
#     ucx libucx0 ucx-tools && rm -rf /var/lib/apt/lists/*

# --- Install uv (Python workflow manager) ---
ENV UV_NO_ANALYTICS=1
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# --- Project setup ---
WORKDIR /app

# Copy only project metadata first to leverage Docker layer caching.
# If your project uses pyproject + uv.lock (recommended), copy them here.
COPY pyproject.toml uv.lock* ./

# Install a controlled Python and sync env (no dev deps by default).
# Pick your version — 3.11 is a good default.
RUN uv python install 3.11 && \
    uv sync --python 3.11 --no-dev --frozen || uv sync --python 3.11 --no-dev

# Now bring the actual source (this invalidates cache only when code changes).
COPY . .

# --- Install your profiler script into PATH (from your repo) ---
# Adjust path if your file lives elsewhere in the repo.
# If the file is named `confing_profiler.sh` in your tree, fix the name here
# or change to match exactly.
COPY scripts/config_profiler.sh /usr/local/bin/config_profiler.sh
RUN chmod +x /usr/local/bin/config_profiler.sh

# (Optional) run once to generate any expected files
# RUN /usr/local/bin/config_profiler.sh

# --- Runtime env knobs for NCCL (tweak as needed) ---
ENV NCCL_DEBUG=WARN \
    NCCL_IB_DISABLE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON=3.11

# If you prefer tini as an init (clean signal handling), uncomment:
# RUN apt-get update && apt-get install -y --no-install-recommends tini && rm -rf /var/lib/apt/lists/*
# ENTRYPOINT ["/usr/bin/tini","--"]

# Default command: run your entry script via uv-managed Python.
# Change path if your entry point differs.
CMD ["uv", "run", "python", "code_evolution/openevolve-run.py"]